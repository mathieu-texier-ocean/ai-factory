#!/usr/bin/env bash
# gh factice des tests de scripts/release-asset.sh. Journalise ses arguments dans $GH_LOG.
#   release view <tag> … → noms des fichiers joints, un par ligne, lus dans $GH_ASSETS
#   release upload <tag> <fichier> → copie le fichier (droits compris) dans $GH_UPLOAD
# GH_FAIL=1 simule une release illisible. Toute autre commande échoue.
set -u
printf '%s\n' "$*" >> "${GH_LOG:-/dev/null}"
[ "${GH_FAIL:-0}" = 0 ] || { echo "gh factice : release introuvable" >&2; exit 1; }
case "${1:-} ${2:-}" in
  "release view")   [ -f "${GH_ASSETS:-}" ] && cat "$GH_ASSETS"; exit 0 ;;
  "release upload") cp -p "$4" "$GH_UPLOAD" ;;
  *) echo "gh factice : commande non prévue : $*" >&2; exit 1 ;;
esac
