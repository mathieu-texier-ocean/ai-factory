#!/usr/bin/env bash
# Trois contrôles :
# 1. Tout intent.md stagé contient les sections obligatoires.
#    Source de vérité : les titres "## " de templates/intent.md (hors "Questions ouvertes").
#    Présence uniquement, pas la qualité du contenu.
# 2. Tout spec.md créé a, dans HEAD, un intent.md validé dans le même dossier (hors templates/ à la racine).
# 3. Aucune ligne ajoutée à un fichier texte indexé ne contient de credential en clair.
#    Une ligne qui porte le marqueur credential-ok est ignorée, ainsi que les fixtures de tests
#    (tests/<nom>/fixtures/, à toute profondeur). La valeur n'est jamais affichée.
set -u

root=$(git rev-parse --show-toplevel)
template="$root/templates/intent.md"
optional="Questions ouvertes"

if [ ! -f "$template" ]; then
  echo "pre-commit : templates/intent.md introuvable, vérification impossible." >&2
  exit 1
fi

required=()
while IFS= read -r line; do
  [ "$line" = "$optional" ] || required+=("$line")
done < <(sed -n 's/^## \(.*[^[:space:]]\)[[:space:]]*$/\1/p' "$template")

status=0
while IFS= read -r path; do
  [ "$(basename "$path")" = "intent.md" ] || continue
  content=$(git show ":$path")
  missing=()
  for section in "${required[@]}"; do
    printf '%s\n' "$content" | grep -qxF "## $section" || missing+=("$section")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    list=$(printf '%s, ' "${missing[@]}"); list=${list%, }
    echo "$path : section(s) obligatoire(s) manquante(s) : $list" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

# Statut lu sur "**Statut :** <valeur>", ligne seule ou ligne de l'auteur. Seul "validé" exact passe.
check_spec_intent() {
  local path=$1 dir intent value
  dir=$(dirname "$path")
  if [ "$dir" = . ]; then intent=intent.md; else intent="$dir/intent.md"; fi
  if ! value=$(git show "HEAD:$intent" 2>/dev/null); then
    echo "$path : intent absent ($intent)" >&2
    status=1; return
  fi
  value=$(printf '%s\n' "$value" | sed -n 's/.*\*\*Statut :\*\* *\([^ ·]*\).*/\1/p' | head -1)
  if [ "$value" != "validé" ]; then
    echo "$path : intent non validé (statut : $value)" >&2
    status=1
  fi
}

while IFS= read -r path; do
  case $path in templates/*) continue ;; esac
  [ "$(basename "$path")" = "spec.md" ] && check_spec_intent "$path"
done < <(git diff --cached --name-only --diff-filter=A)

# Une famille par indice : nom affiché, motif grep -E, option de casse.
familles=("clé privée" "jeton fournisseur" "affectation générique" "URL avec identifiants")
motifs=(
  '-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----'
  'AKIA[A-Z0-9]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk-ant-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}'
  "(password|secret|token|api_key)[[:space:]]*=[[:space:]]*[\"']?[^\"'\$<{[:space:]][^\"'[:space:]]{3,}"
  '[A-Za-z][A-Za-z0-9+.-]*://[^/:@[:space:]]+:[^/@[:space:]]+@'
)
casse=("" "" "-i" "")

# -z : chemins bruts, sans les guillemets de core.quotePath. -M : un renommage donne
# "<ajouts>\t<suppressions>\t" puis l'ancien et le nouveau chemin ; binaire : "-\t-".
while IFS= read -r -d '' rec; do
  ajouts=${rec%%$'\t'*}
  chemin=${rec#*$'\t'}; chemin=${chemin#*$'\t'}
  ancien=$chemin
  if [ -z "$chemin" ]; then
    IFS= read -r -d '' ancien; IFS= read -r -d '' chemin
  fi
  [ "$ajouts" = - ] && continue
  # Le "/" en tête couvre tests/ à la racine.
  case "/$chemin" in */tests/*/fixtures/*) continue ;; esac
  # Les deux chemins gardent le renommage apparié : seules les lignes ajoutées sont lues.
  lignes=$(git diff --cached -U0 -M --no-color -- "$ancien" "$chemin" \
    | awk '/^@@/ { h = 1; next } h && /^\+/' | grep -vF credential-ok)
  [ -n "$lignes" ] || continue
  for i in "${!familles[@]}"; do
    if printf '%s\n' "$lignes" | grep -qE ${casse[i]} -e "${motifs[i]}"; then
      echo "$chemin : credential en clair (${familles[i]}). Retirez la valeur, remplacez-la par une référence (variable d'environnement, gestionnaire de secrets) et révoquez-la si elle est réelle. Faux positif : ajoutez credential-ok en commentaire sur la ligne." >&2
      status=1
    fi
  done
done < <(git diff --cached --numstat -z -M --diff-filter=ACMR)

exit $status
