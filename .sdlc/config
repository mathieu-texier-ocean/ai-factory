# Configuration partagée de git-sdlc (format git config, lue par le script).
# Une valeur locale (git config sdlc.<clé>) l'emporte sur ce fichier.
[sdlc]
	# Branche protégée vers laquelle toutes les PR sont ouvertes.
	main = main
	# Dossier des artefacts de besoin.
	intentDir = intent
	# Équipe GitHub autorisée à créer les tags release/* (git sdlc setup).
	releaseTeam = release-managers
	# Nombre maximal de PR lues par status et board.
	prLimit = 300
